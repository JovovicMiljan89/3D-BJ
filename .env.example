# Copy this file to .env and fill in real values before running `npm start`.

PORT=3000
NODE_ENV=development

# Long random string — used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Initial admin login. Only used the very first time the server runs
# (when data/db.json doesn't exist yet) to create the admin account.
# Change the password from the admin panel afterwards — these values
# are not read again once the account is seeded.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
